{
    "compilerOptions": {
        "target": "ESNext",
        "lib": ["ESNext", "WebWorker"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true,
        "resolveJsonModule": true,
        "types": ["@cloudflare/workers-types"]
    },
    "include": ["."]
}
